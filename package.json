{
    "main": "node_modules/expo/AppEntry.js",
    "scripts": {
        "start": "expo start",
        "android": "expo start --android",
        "ios": "expo start --ios",
        "web": "expo start --web",
        "eject": "expo eject",
        "server": "json-server-auth db.json --port 3001 --watch",
        "test": "jest"
    },
 "jest": {
  "preset": "jest-expo",
  "setupFilesAfterEnv": [
    "<rootDir>/jest-setup.ts"
  ],
  "testPathIgnorePatterns": [
    "/node_modules/",
    "/android/",
    "/ios/"
  ],
  "transformIgnorePatterns": [
    "node_modules/(?!(@react-native|react-native|react-navigation|@react-navigation|react-native-gesture-handler|react-native-reanimated|@react-native-masked-view|expo(nent)?|@expo|expo-linear-gradient|expo-status-bar|expo-location|expo-constants|expo-modules-core|expo-font|expo-image-picker)/)"
  ]
},
    "dependencies": {
        "@expo-google-fonts/nunito": "^0.2.2",
