        "axios": "^1.2.1",
        "expo": "^47.0.0",
        "expo-constants": "~14.0.2",
        "expo-font": "~11.0.1",
        "expo-image-picker": "~14.0.2",
        "expo-linear-gradient": "~12.0.1",
        "expo-location": "~15.0.1",
        "expo-status-bar": "~1.4.2",
        "expo-updates": "~0.15.6",
        "json-server": "^0.17.1",
        "json-server-auth": "^2.1.0",
        "jwt-decode": "^3.1.2",
        "react": "18.1.0",
        "react-dom": "18.1.0",
