        "uuid": "^9.0.0"
    },
    "devDependencies": {
        "@testing-library/react-native": "^12.4.0",
        "@types/jest": "^26.0.24",
        "@types/react": "~18.0.24",
        "@types/react-dom": "~18.0.8",
        "@types/react-native": "~0.70.6",
        "@types/uuid": "^9.0.0",
        "jest": "^26.6.3",
        "jest-expo": "~47.0.1",
        "react-test-renderer": "18.1.0",
        "typescript": "^4.6.3"
    },
    "jest": {
        "preset": "jest-expo",
        "setupFiles": [
            "./node_modules/react-native-gesture-handler/jestSetup.js",
            "./jest.setup.js"
